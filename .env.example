# Copy this file to `.env` and fill in real values before `docker compose up`.

# REQUIRED. The server refuses to boot without this. Generate a strong secret:
#   openssl rand -hex 32
JWT_SECRET=

# Optional. Password for the PostgreSQL user (defaults to `mcpgateway`).
# POSTGRES_PASSWORD=change-me

# Optional. Initial admin password. If left unset, it defaults to `admin` and a
# password change is forced on first login. Set it to choose your own initial
# password instead.
# MCPGW_ADMIN_PASSWORD=

# Optional. The dashboard's update check, which asks GitHub for the newest
# release. Set UPDATE_CHECK_DISABLED to any truthy value on an air-gapped
# deployment; `0`, `false`, `off` and an empty value all leave it on.
# UPDATE_CHECK_DISABLED=1
# UPDATE_CHECK_REPO=SidPad03/unified-mcp-gateway
# GITHUB_TOKEN=
